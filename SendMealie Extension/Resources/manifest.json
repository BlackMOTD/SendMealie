{
  "manifest_version": 3,
  "name": "SendMealie",
  "version": "1.0.0",
  "description": "Envoie la recette de la page courante vers Mealie.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Envoyer à Mealie",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon-32.svg",
    "128": "icons/icon-128.svg"
  }
}
