{
  "manifest_version": 3,
  "name": "SendMealie",
  "version": "0.0.1",
  "description": "Envoie la recette de la page courante vers Mealie.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Enregistrer sur Mealie",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "toolbar-off-16.png",
      "32": "toolbar-off-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "128": "icon-128.png"
  }
}
