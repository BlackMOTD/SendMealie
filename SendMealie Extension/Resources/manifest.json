{
  "manifest_version": 3,
  "name": "SendMealie",
  "version": "0.1.0",
  "description": "Envoie la recette de la page courante vers Mealie.",
  "permissions": [
    "activeTab",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Enregistrer sur Mealie",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "toolbar-off-16.png",
      "32": "toolbar-off-32.png"
    }
  },
  "background": {
    "scripts": [
      "i18n.js",
      "bridge.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "i18n.js",
        "claim-token.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "128": "icon-128.png"
  }
}
